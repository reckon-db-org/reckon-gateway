[
    {reckon_gateway, [
        {listen_port, 50051},
        {listen_ip, {0, 0, 0, 0}}
    ]},

    {reckon_db, [
        {stores, [
            {default_store, [
                {data_dir, "/tmp/reckon_gateway/default_store"},
                {mode, single},
                {writer_pool_size, 10},
                {reader_pool_size, 10},
                {gateway_pool_size, 2}
            ]}
        ]}
    ]},

    {reckon_gater, [
        {retry, [
            {base_delay_ms, 100},
            {max_delay_ms, 30000},
            {max_attempts, 10}
        ]}
    ]},

    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                level => info,
                formatter => {logger_formatter, #{
                    template => [time, " [", level, "] ", msg, "\n"]
                }}
            }}
        ]}
    ]}
].
