%% Runtime config — env-var driven where it varies per deployment.
%%
%% Variables read from env (with sensible defaults in the Containerfile):
%%
%%   RECKON_GATEWAY_PORT             gRPC listen port (default 50051)
%%   RECKON_GATEWAY_CLUSTERS_PATH    Absolute path to clusters.eterm
%%                                    (operator-curated cookies; OUT of
%%                                    gitops). When unset the catalogue
%%                                    boots with zero clusters and every
%%                                    data RPC returns store_unknown.
%%
%% Erlang dist:
%%   - Per-peer cookies are set at runtime by reckon_gateway_cluster_connector,
%%     so the BEAM's default cookie is unused for clusters.eterm targets.
%%   - dist_auto_connect is set to `never` so the gateway only connects
%%     to nodes it explicitly pings; this prevents accidental
%%     auto-connect attempts with the wrong cookie.

[
    {reckon_gateway, [
        {listen_port,          ${RECKON_GATEWAY_PORT}},
        {listen_ip,            {0, 0, 0, 0}},
        {clusters_config_path, "${RECKON_GATEWAY_CLUSTERS_PATH}"},
        {refresh_interval_ms,  30000}
    ]},

    {reckon_gater, [
        {retry, [
            {base_delay_ms, 100},
            {max_delay_ms,  30000},
            {max_attempts,  10}
        ]}
    ]},

    {kernel, [
        {dist_auto_connect, never},
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                level => info,
                formatter => {logger_formatter, #{
                    template => [time, " [", level, "] ", msg, "\n"]
                }}
            }}
        ]}
    ]}
].
