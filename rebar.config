{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

{deps, [
    {grpc, {git, "https://github.com/emqx/grpc-erl.git", {branch, "master"}}},
    %% Override emqx/cowboy fork with mainline. emqx/cowboy ships an
    %% HTTP/2 `commands' handler that routes `{trailers, _}' through
    %% `send_or_queue_data', but cowlib's `send_or_queue_data' has
    %% no clause for trailers and crashes with `case_clause' on the
    %% trailing `grpc-status' frame. Mainline cowboy 2.15 + cowlib
    %% 2.16.1 handle trailers via `prepare_trailers' end-to-end.
    %% Without this override every server-streaming RPC silently
    %% crashes the cowboy connection on stream end.
    {cowboy, {git, "https://github.com/ninenines/cowboy.git", {tag, "2.15.0"}}},
    {cowlib, {git, "https://github.com/ninenines/cowlib.git", {tag, "2.16.1"}}},
    {ranch, {git, "https://github.com/ninenines/ranch.git", {tag, "1.8.1"}}},
    {reckon_gater, "~> 2.2"},
    %% reckon_db is re-added in 0.6.0 as an OPTIONAL embedded-store
    %% backend. When `RECKON_GATEWAY_STORE_ENABLED=true`, the gateway
    %% boots a local store via `reckon_db_sup:start_store/1`. When the
    %% env is unset/false, reckon_db's tree is up but no stores run —
    %% pure catalogue mode is unaffected. See
    %% plans/DESIGN_RECKON_GATEWAY_HYBRID_MODE.md.
    {reckon_db, "~> 3.0"},

    %% Canonical proto bundle — consumed at build time by
    %% grpc_plugin (see {grpc, [...]} below). The local proto/ dir
    %% in this repo was removed in 0.4.1; protos now live exactly
    %% once, in reckon-proto.
    {reckon_proto, {git, "https://codeberg.org/reckon-db-org/reckon-proto.git", {tag, "v0.4.0"}}},
    {telemetry, "1.3.0"}
]}.

{project_plugins, [
    {grpc_plugin, {git, "https://github.com/HJianBo/grpc_plugin.git", {tag, "v0.10.3"}}},
    rebar3_ex_doc,
    rebar3_hex
]}.

{grpc, [
    {type, all},
    {protos, ["_build/default/lib/reckon_proto/proto"]},
    {out_dir, "src/"},
    {gpb_opts, [
        {module_name_suffix, "_pb"},
        {i, "_build/default/lib/reckon_proto/proto"},
        use_packages,
        maps,
        strings_as_binaries,
        {maps_unset_optional, omitted}
    ]}
]}.

{provider_hooks, [
    {pre, [{compile, {grpc, gen}}]},
    {post, [{clean, {grpc, clean}}]}
]}.

{profiles, [
    {test, [
        {deps, [
            {meck, "0.9.2"}
        ]},
        {erl_opts, [
            debug_info,
            nowarn_export_all
        ]},
        {extra_src_dirs, [
            "test/unit",
            "test/integration"
        ]}
    ]},
    {prod, [
        {erl_opts, [
            no_debug_info,
            deterministic
        ]},
        {relx, [
            {release, {reckon_gateway, "0.6.2"}, [
                reckon_gateway,
                sasl
            ]},
            {dev_mode, false},
            {include_erts, true},
            {extended_start_script, true},
            {sys_config_src, "config/sys.config.src"},
            {vm_args_src, "config/vm.args.src"}
        ]}
    ]}
]}.

{shell, [
    {apps, [reckon_gateway]}
]}.

{relx, [
    {release, {reckon_gateway, "0.6.2"}, [
        reckon_gateway,
        sasl
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args.src"}
]}.

%% EUnit configuration
{eunit_opts, [
    verbose,
    {report, {eunit_surefire, [{dir, "_build/test/reports"}]}}
]}.

%% Dialyzer configuration
{dialyzer, [
    {warnings, [
        unknown,
        unmatched_returns,
        error_handling,
        underspecs
    ]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [kernel, stdlib, crypto]}
]}.

%% Ex_doc configuration
{ex_doc, [
    {extras, [
        {"README.md", #{title => <<"Readme">>}},
        {"LICENSE", #{title => <<"License">>}},
        {"CHANGELOG.md", #{title => <<"Changelog">>}}
    ]},
    {main, <<"README.md">>},
    {source_url, <<"https://codeberg.org/reckon-db-org/reckon-gateway">>}
]}.

%% Hex configuration
{hex, [
    {doc, #{provider => ex_doc}}
]}.
