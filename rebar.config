%% vendor/grpc is a source tree of this repository, not a dependency fetched
%% from anywhere: it is built as a project app beside src/ so the gRPC runtime
%% is a commit here (reckon-gateway#5).
{project_app_dirs, [".", "vendor/grpc"]}.

{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

{deps, [
    %% The gRPC runtime is not fetched: it is vendor/grpc, a source tree of
    %% this repository, because emqx/grpc-erl publishes to no registry (the
    %% hex package called `grpc' is elixir-grpc, a different project). A path
    %% dependency that stays inside its own repository is a workspace member,
    %% not a dependency on somebody else's source tree, and the gRPC runtime
    %% is now a commit of this repository rather than a branch that can move
    %% under a release (reckon-gateway#5). It is built as a project app, so
    %% everything it needs is named here rather than in its own manifest.
    %%
    %% cowboy is mainline, from the registry. grpc-erl names the emqx/cowboy
    %% fork, whose HTTP/2 command path routes the trailing `{trailers, _}'
    %% frame through `send_or_queue_data', which is reported to crash with
    %% `case_clause' on a server-streaming RPC's closing `grpc-status' frame.
    %% The streaming gate on this branch does NOT reproduce that against the
    %% fork at 2.13.0-emqx-3, so the override is kept for the reason that does
    %% survive: mainline is a registry release, and the fork is an
    %% unmaintained git tag on somebody else's repository.
    %%
    %% Hex, not the git tags these used to name: same releases, but a tag
    %% can be moved and a registry release cannot (reckon-gateway#5).
    {cowboy, "2.15.0"},
    {cowlib, "2.16.1"},
    {ranch, "1.8.1"},
    %% The rest of what vendor/grpc needs at run time. They are declared here
    %% and not in vendor/grpc/rebar.config because a project app's {deps, ...}
    %% is merged into this same graph, and the gRPC runtime is a member of
    %% this build rather than a fetched dependency with a manifest of its own.
    {gpb, "~> 4.21"},
    {gproc, "1.0.0"},
    {gun, "2.1.0"},
    {reckon_gater, "~> 3.7"},
    %% reckon_db is re-added in 0.6.0 as an OPTIONAL embedded-store
    %% backend. When `RECKON_GATEWAY_STORE_ENABLED=true`, the gateway
    %% boots a local store via `reckon_db_sup:start_store/1`. When the
    %% env is unset/false, reckon_db's tree is up but no stores run —
    %% pure catalogue mode is unaffected. See
    %% plans/DESIGN_RECKON_GATEWAY_HYBRID_MODE.md.
    {reckon_db, "~> 5.5"},

    %% Canonical proto bundle — consumed at build time by
    %% grpc_plugin (see {grpc, [...]} below). The local proto/ dir
    %% in this repo was removed in 0.4.1; protos now live exactly
    %% once, in reckon-proto.
    %% Pinned by commit, not by tag: a tag can be moved, a commit cannot.
    {reckon_proto, {git, "https://github.com/reckon-db-org/reckon-proto.git",
                    {ref, "3169e44fe43f699c39fb77ae8e85a25d63bc48c4"}}}, %% v0.8.0
    {telemetry, "1.3.0"}
]}.

{project_plugins, [
    %% Pinned by commit, not by tag: a tag can be moved, a commit cannot.
    {grpc_plugin, {git, "https://github.com/HJianBo/grpc_plugin.git",
                   {ref, "24de3c387d5b996745fe98f3b4e76c8c00341a6d"}}}, %% v0.10.3
    rebar3_ex_doc,
    rebar3_hex,
    rebar3_lint
]}.

%% Elvis style rules: the structural lint floor (macula-codebase-checks#9),
%% nesting 2, no nested try/catch, no if, functions of at most 60 lines.
%% Generated grpc artefacts (*_pb, *_client, *_bhvr) are excluded; they
%% are not ours to restyle. Run via `rebar3 lint`.
{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}},
            {elvis_style, max_function_length, #{max_length => 60}}
        ]
    }},
    {config, [
        #{files => ["src/**/*.erl"],
          ignore => [".*_pb", ".*_client", ".*_bhvr"],
          ruleset => macula_min}
    ]}
]}.

{grpc, [
    {type, all},
    {protos, ["_build/default/lib/reckon_proto/proto"]},
    {out_dir, "src/"},
    {gpb_opts, [
        {module_name_suffix, "_pb"},
        {i, "_build/default/lib/reckon_proto/proto"},
        use_packages,
        maps,
        strings_as_binaries,
        {maps_unset_optional, omitted}
    ]}
]}.

{provider_hooks, [
    {pre, [{compile, {grpc, gen}}]},
    {post, [{clean, {grpc, clean}}]}
]}.

{profiles, [
    {test, [
        {deps, [
            {meck, "0.9.2"}
        ]},
        {erl_opts, [
            debug_info,
            nowarn_export_all
        ]},
        {extra_src_dirs, [
            "test/unit",
            "test/integration"
        ]}
    ]},
    %% relx-only, deliberately no erl_opts: rebar3 merges a fetched
    %% dependency's erl_opts across EVERY profile it defines, not just
    %% whichever one the consumer actually activated. This profile's
    %% `no_debug_info'/`deterministic' were silently stripping
    %% debug_info from every consumer's copy of reckon_gateway, whether
    %% or not they ever selected `prod' themselves. Identical bug,
    %% identical fix, found and verified on macula-io/macula 2026-09-05
    %% (10.19.2) via a controlled A/B dependency-fetch rebuild; same
    %% org-wide sweep found this repo has the exact same profile shape.
    %% Pass `--erl_opts +no_debug_info' on the `rebar3 as prod release'
    %% command line instead if a leaner local release build is ever
    %% needed again.
    {prod, [
        {relx, [
            %% This literal is the releases/<vsn>/ dir and the boot-script
            %% version, and it MUST equal src/reckon_gateway.app.src {vsn}: it
            %% said 0.27.0 while the app and every tag said 0.30.1, so six
            %% releases booted reporting the wrong version (reckon-gateway#2).
            %% It stays a literal because the release guard reads this tuple
            %% as TEXT from rebar.config (macula-ci-images#6) -- a value an
            %% atom or rebar.config.script supplies counts as one the file
            %% cannot spell, and the tag is refused. The drift is caught
            %% instead: reckon_gateway_release_version_tests fails whenever
            %% this and the app {vsn} disagree.
            {release, {reckon_gateway, "0.30.2"}, [
                reckon_gateway,
                sasl
            ]},
            {dev_mode, false},
            {include_erts, true},
            {extended_start_script, true},
            {sys_config_src, "config/sys.config.src"},
            {vm_args_src, "config/vm.args.src"}
        ]}
    ]}
]}.

{shell, [
    {apps, [reckon_gateway]}
]}.

{relx, [
    %% Same literal, same rule as the prod profile above: must equal
    %% src/reckon_gateway.app.src {vsn}, pinned by
    %% reckon_gateway_release_version_tests (reckon-gateway#2).
    {release, {reckon_gateway, "0.30.2"}, [
        reckon_gateway,
        sasl
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args.src"}
]}.

%% EUnit configuration
{eunit_opts, [
    verbose,
    {report, {eunit_surefire, [{dir, "_build/test/reports"}]}}
]}.

%% Dialyzer configuration
{dialyzer, [
    {warnings, [
        unknown,
        unmatched_returns,
        error_handling,
        underspecs
    ]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [kernel, stdlib, crypto]}
]}.

%% Ex_doc configuration
{ex_doc, [
    {extras, [
        {"README.md", #{title => <<"Readme">>}},
        {"LICENSE", #{title => <<"License">>}},
        {"CHANGELOG.md", #{title => <<"Changelog">>}}
    ]},
    {main, <<"README.md">>},
    {source_url, <<"https://github.com/reckon-db-org/reckon-gateway">>}
]}.

%% Hex configuration
{hex, [
    {doc, #{provider => ex_doc}}
]}.
