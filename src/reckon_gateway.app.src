{application, reckon_gateway, [
    {description, "Multi-cluster catalogue gateway for ReckonDB. "
                  "Pure gRPC ingress; routes each request via Erlang dist "
                  "rpc:call/4 to whichever BEAM owns the target store. "
                  "Does NOT carry data."},
    {vsn, "0.5.0"},
    {registered, [reckon_gateway_sup]},
    {mod, {reckon_gateway_app, []}},
    {applications, [
        kernel,
        stdlib,
        grpc,
        reckon_gater,
        telemetry
    ]},
    {env, [
        {listen_port, 50051},
        {listen_ip, {0, 0, 0, 0}}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"Codeberg", "https://codeberg.org/reckon-db-org/reckon-gateway"}
    ]}
]}.
