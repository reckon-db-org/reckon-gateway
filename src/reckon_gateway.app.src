{application, reckon_gateway, [
    {description, "Multi-cluster catalogue gateway for ReckonDB with "
                  "optional embedded-store mode. By default a pure gRPC "
                  "ingress that routes via `rpc:call/4` to remote BEAMs; "
                  "with `RECKON_GATEWAY_STORE_ENABLED=true` also boots "
                  "a local reckon-db store and serves it from the same "
                  "image. See DESIGN_RECKON_GATEWAY_HYBRID_MODE.md."},
    {vsn, "0.25.0"},
    {registered, [reckon_gateway_sup]},
    {mod, {reckon_gateway_app, []}},
    {applications, [
        kernel,
        stdlib,
        grpc,
        reckon_gater,
        reckon_db,
        telemetry
    ]},
    {env, [
        {listen_port, 50051},
        {listen_ip, {0, 0, 0, 0}}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"Codeberg", "https://codeberg.org/reckon-db-org/reckon-gateway"}
    ]}
]}.
