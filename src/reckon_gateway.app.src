{application, reckon_gateway, [
    {description, "gRPC gateway for ReckonDB event store. "
                  "Exposes ReckonDB operations over gRPC for polyglot access."},
    {vsn, "0.1.0"},
    {registered, [reckon_gateway_sup]},
    {mod, {reckon_gateway_app, []}},
    {applications, [
        kernel,
        stdlib,
        grpcbox,
        reckon_gater,
        reckon_db,
        telemetry
    ]},
    {env, [
        {listen_port, 50051},
        {listen_ip, {0, 0, 0, 0}}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/reckon-db-org/reckon-gateway"}
    ]}
]}.
