%% Vendored emqx/grpc-erl, app `grpc', at upstream commit
%% acaa5321bd3994ae51d6457c351552c30f6c6173 (see NOTICE).
%%
%% This app is a member of this repository's build ({project_app_dirs} in the
%% root rebar.config), not a dependency fetched from somewhere, so its
%% dependency graph is declared in the ROOT rebar.config only. An umbrella
%% merges a project app's {deps, ...} into the root graph, so listing cowboy,
%% cowlib, ranch, gun, gpb or gproc here would add a second declaration of an
%% app the root already names, and the two could disagree. Upstream's own
%% rebar.config also carries a grpc_plugin hook that generates src/ from
%% priv/*.proto; a dependency's project plugins do not run, which is why the
%% generated modules are committed, and the plugin is deliberately absent.
%%
%% Regenerate src/*_pb.erl and the generated clients/bhvr modules with
%% upstream's tooling if priv/ ever changes, and commit the result.
{erl_opts, [debug_info]}.
